{
  "name": "wa-export",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Export selected WhatsApp Web messages and media to a ZIP, locally.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "sign:firefox": "scripts/sign-firefox.sh",
    "test:firefox": "node scripts/firefox-smoke/run.mjs",
    "demo:assets": "node scripts/demo/make-assets.mjs",
    "demo": "node scripts/demo/render.mjs"
  },
  "dependencies": {
    "@wppconnect/wa-js": "4.7.2",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "rolldown": "1.2.15",
    "selenium-webdriver": "4.51.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@10.29.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sivefunc/wa-export.git"
  },
  "bugs": {
    "url": "https://github.com/sivefunc/wa-export/issues"
  },
  "homepage": "https://github.com/sivefunc/wa-export#readme"
}
